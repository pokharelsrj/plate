# Seed admin account, created on first boot if no users exist. This account
# also owns the scheduled syncs below, since their credentials are per-server
# rather than per-user.
AUTH_USER=admin@example.com
AUTH_PASS=change-me

# Self-service sign-up. Leave this unset and the /api/auth/signup endpoint
# refuses everything, which is the default — a fresh server is never open to
# whoever finds it. Set it and anyone holding the code can create their own
# account from the app's sign-in screen. Generate one with:
#   openssl rand -hex 8
SIGNUP_INVITE_CODE=

# Database file path (defaults to ./data.db)
DB_PATH=./data.db

# LA Fitness credentials — used to sync gym check-ins
LAFITNESS_USER=your-lafitness-username
LAFITNESS_PASS=change-me

# Healthifyme credentials — used to sync nutrition
# The API key is "<account email>:<token>" as issued by Healthifyme
HEALTHIFYME_API_KEY=you@example.com:your-healthifyme-token
HEALTHIFYME_USER_ID=000000

# Apple Health ingestion API key (sent by the iOS Shortcut in the X-Api-Key
# header, and used as the seed admin's API key). Generate with:
#   openssl rand -hex 32
HEALTH_API_KEY=change-me

# Date of birth (YYYY-MM-DD) — used to compute age for the body fat % formula
USER_DOB=1990-01-01
