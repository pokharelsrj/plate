# Example reverse proxy for the one endpoint that has to be reachable from
# outside the LAN. Replace the hostname with your own.
health.example.com {
	# Public path: ONLY the Apple Health ingest endpoint (the iOS Shortcut
	# posts here from anywhere). Auth is via X-Api-Key on the Go server.
	handle /api/health/ingest {
		reverse_proxy localhost:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else — the rest of the API — is VPN/LAN-only: the app
	# reaches the server directly at http://<host>:8080.
	handle {
		respond "Not Found" 404
	}

	log {
		output file /var/log/caddy/health-api.log
		format json
	}
}
