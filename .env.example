# Authentication for the web UI
AUTH_USER=yourname
AUTH_PASS=yourpassword

# Database file path (defaults to ./data.db)
DB_PATH=/home/youruser/pi-webpage/data.db

# LA Fitness credentials
LAFITNESS_USER=your-lafitness-username
LAFITNESS_PASS=yourpassword

# Healthifyme credentials
HEALTHIFYME_API_KEY=email@example.com:abcdef1234567890
HEALTHIFYME_USER_ID=000000

# Apple Health ingestion API key (used by iOS Shortcut in X-Api-Key header)
HEALTH_API_KEY=long-random-string-here

# Date of birth (YYYY-MM-DD) — used to compute age for body fat % formula
USER_DOB=1990-01-01
