package components

import "fmt"

type StatsData struct {
	CPUPercent    float64
	MemPercent    float64
	MemUsedGB     float64
	MemTotalGB    float64
	DiskPercent   float64
	DiskUsedGB    float64
	DiskTotalGB   float64
	TempCelsius   float64
	UptimeHours   float64
	LoadAvg1      float64
	LoadAvg5      float64
	LoadAvg15     float64
}

templ StatsPartial(s StatsData) {
	<div id="stats-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
		@metricCard("CPU", fmt.Sprintf("%.1f%%", s.CPUPercent), s.CPUPercent, fmt.Sprintf("load %.2f  %.2f  %.2f", s.LoadAvg1, s.LoadAvg5, s.LoadAvg15))
		@metricCard("MEMORY", fmt.Sprintf("%.1f%%", s.MemPercent), s.MemPercent, fmt.Sprintf("%.1f GB / %.1f GB", s.MemUsedGB, s.MemTotalGB))
		@metricCard("DISK", fmt.Sprintf("%.1f%%", s.DiskPercent), s.DiskPercent, fmt.Sprintf("%.1f GB / %.1f GB", s.DiskUsedGB, s.DiskTotalGB))
		@tempCard(s.TempCelsius, s.UptimeHours)
	</div>
}

templ metricCard(label string, value string, percent float64, sub string) {
	<div class="card bg-base-100 border border-base-content/10">
		<div class="card-body p-4 gap-3">
			<div class="flex justify-between items-baseline">
				<span class="metric-label text-base-content/50">{ label }</span>
				<span class="text-2xl font-bold text-primary">{ value }</span>
			</div>
			<progress class="progress progress-primary w-full" value={ fmt.Sprintf("%.0f", percent) } max="100"></progress>
			<span class="text-xs text-base-content/40 font-mono">{ sub }</span>
		</div>
	</div>
}

templ tempCard(temp float64, uptimeHours float64) {
	<div class="card bg-base-100 border border-base-content/10">
		<div class="card-body p-4 gap-3">
			<div class="flex justify-between items-baseline">
				<span class="metric-label text-base-content/50">TEMP</span>
				<span class={ "text-2xl font-bold", tempColor(temp) }>{ fmt.Sprintf("%.1f°C", temp) }</span>
			</div>
			<progress class={ "progress w-full", tempProgressColor(temp) } value={ fmt.Sprintf("%.0f", temp) } max="85"></progress>
			<span class="text-xs text-base-content/40 font-mono">uptime { fmt.Sprintf("%.1fh", uptimeHours) }</span>
		</div>
	</div>
}

func tempColor(t float64) string {
	if t >= 70 {
		return "text-error"
	} else if t >= 55 {
		return "text-warning"
	}
	return "text-primary"
}

func tempProgressColor(t float64) string {
	if t >= 70 {
		return "progress-error"
	} else if t >= 55 {
		return "progress-warning"
	}
	return "progress-primary"
}
