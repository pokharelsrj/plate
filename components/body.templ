package components

import (
	"database/sql"
	"fmt"

	"pi-webpage/db"
)

func formatNullFloat(v sql.NullFloat64, format string) string {
	if !v.Valid {
		return "—"
	}
	return fmt.Sprintf(format, v.Float64)
}

type BodyPageModel struct {
	Today    string
	History  []db.BodyMetric
	ErrorMsg string
	OkMsg    string
	HasDOB   bool
}

templ BodyPage(m BodyPageModel) {
	@Layout("body") {
		<div class="page-header">
			<div>
				<div class="metric-label">body metrics</div>
				<div class="metric-sub">weight &middot; body fat %</div>
			</div>
		</div>

		if m.OkMsg != "" {
			<div class="form-ok">&#10003; saved</div>
		}
		if m.ErrorMsg != "" {
			<div class="form-err">{ m.ErrorMsg }</div>
		}
		if !m.HasDOB {
			<div class="form-warn">
				USER_DOB not set in .env — BF% won't be computed until you add it (format YYYY-MM-DD).
			</div>
		}

		<div class="body-forms">
			<form class="body-form" method="POST" action="/body">
				<div class="form-title">LOG WEIGHT</div>
				<div class="body-row">
					<label class="body-field">
						<span class="metric-label">DATE</span>
						<input type="date" name="date" value={ m.Today } class="body-input" required/>
					</label>
					<label class="body-field">
						<span class="metric-label">WEIGHT (LBS)</span>
						<input type="number" step="0.1" min="0" name="weight_lbs" placeholder="170.5" class="body-input" required/>
					</label>
				</div>
				<div style="margin-top: 1rem;">
					<button type="submit" class="btn-terminal">save weight</button>
				</div>
			</form>

			<form class="body-form" method="POST" action="/body">
				<div class="form-title">LOG BODY FAT</div>
				<div class="body-row">
					<label class="body-field">
						<span class="metric-label">DATE</span>
						<input type="date" name="date" value={ m.Today } class="body-input" required/>
					</label>
				</div>
				<div class="body-row" style="margin-top: 0.5rem;">
					<label class="body-field">
						<span class="metric-label">CHEST (MM)</span>
						<input type="number" step="0.1" min="0" name="chest_mm" placeholder="12.5" class="body-input" required/>
					</label>
					<label class="body-field">
						<span class="metric-label">ABDOMEN (MM)</span>
						<input type="number" step="0.1" min="0" name="abdomen_mm" placeholder="18.0" class="body-input" required/>
					</label>
					<label class="body-field">
						<span class="metric-label">THIGH (MM)</span>
						<input type="number" step="0.1" min="0" name="thigh_mm" placeholder="14.0" class="body-input" required/>
					</label>
				</div>
				<div style="margin-top: 1rem;">
					<button type="submit" class="btn-terminal">save body fat</button>
					<span class="metric-sub" style="margin-left: 0.75rem;">BF% auto-computed (Jackson-Pollock)</span>
				</div>
			</form>
		</div>

		<div class="metric-label" style="margin: 1.5rem 0 0.5rem;">HISTORY</div>
		if len(m.History) == 0 {
			<div class="detail-empty">no entries yet</div>
		} else {
			<div class="runs-table">
				<table>
					<thead>
						<tr>
							<th>DATE</th>
							<th>WEIGHT</th>
							<th>BF %</th>
							<th>CHEST</th>
							<th>ABDOMEN</th>
							<th>THIGH</th>
						</tr>
					</thead>
					<tbody>
						for _, b := range m.History {
							<tr>
								<td>{ b.Date }</td>
								<td class="weight-color">{ formatNullFloat(b.WeightLbs, "%.1f lb") }</td>
								<td class="bf-color">{ formatNullFloat(b.BfPercent, "%.1f%%") }</td>
								<td>{ formatNullFloat(b.ChestMm, "%.1f") }</td>
								<td>{ formatNullFloat(b.AbdomenMm, "%.1f") }</td>
								<td>{ formatNullFloat(b.ThighMm, "%.1f") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<style>
			.form-ok { color: var(--green); background: var(--green-faint); border: 1px solid var(--green-dim);
				padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.75rem; margin-bottom: 1rem; letter-spacing: 0.1em; }
			.form-err { color: #ff7766; background: rgba(255,80,80,0.08); border: 1px solid rgba(255,80,80,0.4);
				padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.75rem; margin-bottom: 1rem; letter-spacing: 0.05em; }
			.form-warn { color: #ffaa00; background: rgba(255,170,0,0.08); border: 1px solid rgba(255,170,0,0.4);
				padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.7rem; margin-bottom: 1rem; }

			.body-forms {
				display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 0.75rem;
			}
			.body-form {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 1.25rem;
			}
			.form-title {
				font-size: 0.65rem; letter-spacing: 0.2em;
				color: var(--green); margin-bottom: 0.75rem;
				padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);
			}
			.body-row {
				display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
				gap: 0.75rem;
			}
			.body-field { display: flex; flex-direction: column; gap: 0.3rem; }
			.body-input {
				background: rgba(0,255,136,0.04);
				border: 1px solid var(--border); border-radius: 4px;
				color: var(--green); font-family: inherit;
				font-size: 0.85rem; padding: 0.5rem 0.6rem;
				outline: none; transition: border-color 0.15s;
			}
			.body-input:focus {
				border-color: var(--green-dim);
				box-shadow: 0 0 8px rgba(0,255,136,0.15);
			}
			.weight-color { color: #5ce1e6 !important; }
			.bf-color { color: #ff70b3 !important; }
		</style>
	}
}
