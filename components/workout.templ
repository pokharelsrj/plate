package components

import (
	"fmt"

	"pi-webpage/db"
)

type WorkoutGroup struct {
	ExerciseID   int64
	ExerciseName string
	BodyPart     string
	Sets         []db.WorkoutSet
}

type PickerGroup struct {
	BodyPart  string
	Exercises []db.Exercise
}

type WorkoutActive struct {
	ExerciseID      int64
	ExerciseName    string
	BodyPart        string
	PrefillReps     int
	PrefillWeight   float64
	TodaySets       []db.WorkoutSet
	LastSessionDate string
	LastSessionSets []db.WorkoutSet
}

type WorkoutPageModel struct {
	Date          string
	PrevDate      string
	NextDate      string
	Today         string
	Exercises     []db.Exercise
	SelectedID    int64
	BodyParts     []string
	PickerGroups  []PickerGroup
	Active        *WorkoutActive
	Groups        []WorkoutGroup
	TotalSets     int
	ExerciseCount int
	ErrorMsg      string
}

templ WorkoutPage(m WorkoutPageModel) {
	@Layout("workout") {
		<div class="wk-topbar">
			<div>
				<div class="metric-label">workout</div>
				<div class="metric-sub">log sets &middot; track over time</div>
			</div>
			<div class="wk-date-nav">
				<a class="cal-nav-btn" href={ templ.SafeURL(fmt.Sprintf("/workout?date=%s", m.PrevDate)) }>&lt;</a>
				<form method="GET" action="/workout" style="margin:0">
					<input type="date" name="date" value={ m.Date } class="body-input" onchange="this.form.submit()" style="font-size:0.75rem;padding:0.3rem 0.5rem;"/>
				</form>
				<a class="cal-nav-btn" href={ templ.SafeURL(fmt.Sprintf("/workout?date=%s", m.NextDate)) }>&gt;</a>
			</div>
		</div>

		if m.ErrorMsg != "" {
			<div class="form-err">{ m.ErrorMsg }</div>
		}

		<div class="wk-totals">
			<div class="wk-total"><span class="wk-total-num">{ fmt.Sprintf("%d", m.ExerciseCount) }</span><span class="wk-total-lbl">EXERCISES</span></div>
			<div class="wk-total"><span class="wk-total-num">{ fmt.Sprintf("%d", m.TotalSets) }</span><span class="wk-total-lbl">SETS</span></div>
		</div>

		if m.Active != nil {
			@activePanel(m.Active, m.Date)
		} else {
			<div class="wk-prompt">
				if len(m.Exercises) == 0 {
					<div class="metric-sub">no exercises yet — add one below to start</div>
				} else {
					<div class="metric-sub">&#9660; tap an exercise to start logging</div>
				}
			</div>
		}

		<div class="wk-picker-head">
			<span class="metric-label">EXERCISES</span>
			<a href="/exercises" class="btn-mini">manage library &rarr;</a>
		</div>

		if len(m.PickerGroups) > 0 {
			<input
				type="text"
				id="ex-search"
				class="body-input"
				placeholder="search exercises..."
				oninput="filterExercises(this.value)"
				style="margin-bottom: 0.75rem;"
			/>
			<div id="picker-grid-container" class="picker-grid">
				for _, g := range m.PickerGroups {
					<div class="picker-group" data-bp={ g.BodyPart }>
						<div class="picker-bodypart">{ g.BodyPart }</div>
						<div class="picker-tiles">
							for _, e := range g.Exercises {
								<a
									class={ "picker-tile", templ.KV("active", e.ID == m.SelectedID) }
									data-name={ e.Name }
									href={ templ.SafeURL(fmt.Sprintf("/workout?date=%s&exercise_id=%d", m.Date, e.ID)) }
								>{ e.Name }</a>
							}
						</div>
					</div>
				}
			</div>
			<div id="picker-empty" style="display:none; color: var(--text-muted); font-size: 0.75rem; padding: 0.75rem; text-align: center;">
				no matches &middot; <a href="/exercises" style="color: var(--green);">add new exercise &rarr;</a>
			</div>
		} else {
			<div class="detail-empty">no exercises yet &middot; <a href="/exercises" style="color: var(--green);">add some &rarr;</a></div>
		}

		<script>
			function filterExercises(q) {
				const query = q.toLowerCase().trim();
				const groups = document.querySelectorAll('#picker-grid-container .picker-group');
				let anyVisible = false;
				groups.forEach(g => {
					let groupHas = false;
					g.querySelectorAll('.picker-tile').forEach(t => {
						const match = query === '' || t.dataset.name.toLowerCase().includes(query);
						t.style.display = match ? '' : 'none';
						if (match) groupHas = true;
					});
					g.style.display = groupHas ? '' : 'none';
					if (groupHas) anyVisible = true;
				});
				document.getElementById('picker-empty').style.display = anyVisible ? 'none' : 'block';
				document.getElementById('picker-grid-container').style.display = anyVisible ? '' : 'none';
			}
		</script>

		if len(m.Groups) > 0 {
			<details class="session-summary" open>
				<summary>
					<span class="metric-label">TODAY'S SESSION</span>
					<span class="metric-sub">{ fmt.Sprintf("%d exercises · %d sets", m.ExerciseCount, m.TotalSets) }</span>
				</summary>
				<div class="session-list">
					for _, g := range m.Groups {
						@sessionGroup(g, m.Date)
					}
				</div>
			</details>
		}

		<style>
			.wk-topbar {
				display:flex; justify-content:space-between; align-items:center;
				margin-bottom: 1rem; gap: 0.75rem; flex-wrap: wrap;
			}
			.wk-date-nav { display:flex; align-items:center; gap: 0.5rem; }
			.wk-totals {
				display:flex; gap: 0.5rem; margin-bottom: 1rem;
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 0.75rem 1rem;
			}
			.wk-total {
				display: flex; flex-direction: column; gap: 0.15rem;
				padding: 0 0.75rem; border-right: 1px solid var(--border);
				flex: 1;
			}
			.wk-total:last-child { border-right: none; }
			.wk-total-num { color: #ffd166; font-size: 1.5rem; font-weight: bold; line-height: 1; }
			.wk-total-lbl { color: var(--text-muted); font-size: 0.55rem; letter-spacing: 0.2em; }

			.wk-prompt {
				background: var(--bg2); border: 1px dashed var(--border);
				border-radius: 6px; padding: 1.25rem;
				text-align: center; margin-bottom: 1rem;
			}

			.wk-picker-head {
				display:flex; justify-content: space-between; align-items: center;
				margin: 1.25rem 0 0.5rem;
			}

			.picker-grid { display:flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; }
			.picker-group {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 0.6rem 0.85rem;
				display: flex; gap: 0.75rem; align-items: center;
				flex-wrap: wrap;
			}
			.picker-bodypart {
				color: var(--text-muted); font-size: 0.6rem;
				letter-spacing: 0.2em; text-transform: uppercase;
				min-width: 80px;
			}
			.picker-tiles { display:flex; gap: 0.4rem; flex-wrap: wrap; }
			.picker-tile {
				color: var(--green); text-decoration: none;
				background: var(--bg); border: 1px solid var(--border);
				border-radius: 4px; padding: 0.4rem 0.75rem;
				font-size: 0.8rem; transition: all 0.15s;
			}
			.picker-tile:hover {
				border-color: var(--green-dim);
				background: var(--green-faint);
				box-shadow: 0 0 6px rgba(0,255,136,0.15);
			}
			.picker-tile.active {
				background: #ffd166; color: #0d1117; border-color: #ffd166;
				box-shadow: 0 0 12px rgba(255,209,102,0.4);
				font-weight: bold;
			}

			.session-summary { margin-top: 1rem; }
			.session-summary summary {
				cursor: pointer; list-style: none;
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 0.65rem 1rem;
				display: flex; justify-content: space-between; align-items: center;
				gap: 0.5rem; flex-wrap: wrap;
			}
			.session-summary summary::-webkit-details-marker { display: none; }
			.session-summary[open] summary { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
			.session-list {
				background: var(--bg2); border: 1px solid var(--border);
				border-top: none; border-radius: 0 0 6px 6px;
				padding: 0.75rem;
				display: flex; flex-direction: column; gap: 0.6rem;
			}
		</style>
	}
}

templ activePanel(a *WorkoutActive, date string) {
	<div class="active-panel">
		<div class="active-head">
			<div>
				<div class="active-name">{ a.ExerciseName }</div>
				if a.BodyPart != "" {
					<div class="active-bp">{ a.BodyPart }</div>
				}
			</div>
			if len(a.TodaySets) > 0 {
				<div class="active-vol">{ fmt.Sprintf("%d sets", len(a.TodaySets)) }<span class="metric-sub" style="margin-left:0.3rem">today</span></div>
			}
		</div>

		<form method="POST" action="/workout/set" class="active-form">
			<input type="hidden" name="date" value={ date }/>
			<input type="hidden" name="exercise_id" value={ fmt.Sprintf("%d", a.ExerciseID) }/>
			<label class="active-input">
				<span class="metric-label">REPS</span>
				<input type="number" name="reps" min="1" max="1000"
					value={ prefillReps(a.PrefillReps) }
					required autofocus class="body-input active-num"/>
			</label>
			<label class="active-input">
				<span class="metric-label">LBS (OPT)</span>
				<input type="number" step="0.5" min="0" name="weight_lbs"
					value={ prefillWeight(a.PrefillWeight) }
					class="body-input active-num"/>
			</label>
			<button type="submit" class="btn-add-set">ADD SET</button>
		</form>

		<div class="active-history">
			<div class="active-history-block">
				<div class="metric-label" style="margin-bottom:0.4rem;">TODAY</div>
				if len(a.TodaySets) > 0 {
					<div class="set-pills">
						for i, s := range a.TodaySets {
							<span class="set-pill set-today">
								<span class="set-pill-num">#{ fmt.Sprintf("%d", i+1) }</span>
								@setPillBody(s)
							</span>
						}
					</div>
				} else {
					<div class="set-empty">no sets yet</div>
				}
			</div>
			if len(a.LastSessionSets) > 0 {
				<div class="active-history-block">
					<div class="metric-label" style="margin-bottom:0.4rem;">LAST &middot; { a.LastSessionDate }</div>
					<div class="set-pills">
						for i, s := range a.LastSessionSets {
							<span class="set-pill set-last">
								<span class="set-pill-num">#{ fmt.Sprintf("%d", i+1) }</span>
								@setPillBody(s)
							</span>
						}
					</div>
				</div>
			}
		</div>
	</div>

	<style>
		.active-panel {
			background: linear-gradient(180deg, rgba(255,209,102,0.06), rgba(0,0,0,0));
			border: 1px solid #ffd166;
			border-radius: 8px; padding: 1.25rem;
			margin-bottom: 1rem;
			box-shadow: 0 0 20px rgba(255,209,102,0.1);
		}
		.active-head {
			display:flex; justify-content:space-between; align-items: flex-start;
			margin-bottom: 1rem; gap: 0.75rem; flex-wrap: wrap;
		}
		.active-name {
			color: #ffd166; font-weight: bold;
			font-size: 1.15rem; letter-spacing: 0.05em;
		}
		.active-bp {
			color: var(--text-muted); font-size: 0.6rem;
			letter-spacing: 0.2em; text-transform: uppercase;
			margin-top: 0.2rem;
		}
		.active-vol {
			color: #ffd166; font-size: 0.9rem; font-weight: bold;
		}

		.active-form {
			display:grid; grid-template-columns: 1fr 1fr auto;
			gap: 0.5rem; align-items: end;
			margin-bottom: 1rem;
		}
		@media (max-width: 500px) {
			.active-form { grid-template-columns: 1fr 1fr; }
			.active-form .btn-add-set { grid-column: 1 / -1; }
		}
		.active-input { display: flex; flex-direction: column; gap: 0.3rem; }
		.active-num {
			font-size: 1.4rem !important;
			text-align: center;
			padding: 0.55rem !important;
		}
		.btn-add-set {
			background: #ffd166; color: #0d1117;
			border: none; border-radius: 4px;
			padding: 0.7rem 1.5rem; cursor: pointer;
			font-family: inherit; font-weight: bold;
			letter-spacing: 0.15em; font-size: 0.85rem;
			transition: all 0.15s;
		}
		.btn-add-set:hover {
			background: #ffdb85;
			box-shadow: 0 0 15px rgba(255,209,102,0.5);
		}

		.active-history {
			display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
		}
		@media (max-width: 500px) {
			.active-history { grid-template-columns: 1fr; }
		}
		.set-pills { display:flex; gap: 0.4rem; flex-wrap: wrap; }
		.set-pill {
			display: inline-flex; align-items: center; gap: 0.35rem;
			background: var(--bg2); border-radius: 4px;
			padding: 0.3rem 0.6rem; font-size: 0.75rem;
		}
		.set-pill.set-today { border: 1px solid rgba(255,209,102,0.5); color: #ffd166; }
		.set-pill.set-last { border: 1px solid var(--border); color: var(--text-muted); }
		.set-pill-num {
			font-size: 0.55rem; letter-spacing: 0.15em;
			opacity: 0.7;
		}
		.set-empty {
			color: var(--text-muted); font-size: 0.75rem;
			padding: 0.5rem 0; letter-spacing: 0.05em;
		}
	</style>
}

templ setPillBody(s db.WorkoutSet) {
	<span>
		{ fmt.Sprintf("%d", s.Reps) }
		if s.WeightLbs.Valid {
			&nbsp;×&nbsp;{ fmt.Sprintf("%.0f", s.WeightLbs.Float64) }
		}
	</span>
}

templ sessionGroup(g WorkoutGroup, date string) {
	<div class="sg-card">
		<div class="sg-head">
			<div>
				<span class="sg-name">{ g.ExerciseName }</span>
				if g.BodyPart != "" {
					<span class="wg-bodypart">{ g.BodyPart }</span>
				}
			</div>
			<span class="sg-vol">{ fmt.Sprintf("%d sets", len(g.Sets)) }</span>
		</div>
		<div class="sg-sets">
			for i, s := range g.Sets {
				<div class="sg-set" id={ fmt.Sprintf("set-row-%d", s.ID) }>
					<div class="sg-display">
						<span class="sg-set-num">#{ fmt.Sprintf("%d", i+1) }</span>
						<span class="sg-set-detail">
							{ fmt.Sprintf("%d reps", s.Reps) }
							if s.WeightLbs.Valid {
								&nbsp;@&nbsp;{ fmt.Sprintf("%.0f lb", s.WeightLbs.Float64) }
							}
						</span>
						<div class="sg-actions">
							<button type="button" class="sg-edit-btn"
								onclick={ toggleSetEdit(s.ID) }
								title="edit">✎</button>
							<form method="POST" action="/workout/set/delete" style="margin:0"
								onsubmit="return confirm('Delete this set?')">
								<input type="hidden" name="set_id" value={ fmt.Sprintf("%d", s.ID) }/>
								<input type="hidden" name="date" value={ date }/>
								<button type="submit" class="wg-del-btn" title="delete">×</button>
							</form>
						</div>
					</div>
					<form method="POST" action="/workout/set/update" class="sg-edit-form" style="display:none">
						<input type="hidden" name="set_id" value={ fmt.Sprintf("%d", s.ID) }/>
						<input type="hidden" name="date" value={ date }/>
						<span class="sg-set-num">#{ fmt.Sprintf("%d", i+1) }</span>
						<input type="number" name="reps" min="1" max="1000" value={ fmt.Sprintf("%d", s.Reps) } class="sg-edit-input" required/>
						<span class="metric-sub">×</span>
						<input type="number" step="0.5" min="0" name="weight_lbs"
							value={ weightOrEmpty(s) }
							placeholder="lbs" class="sg-edit-input"/>
						<button type="submit" class="btn-mini">save</button>
						<button type="button" class="btn-mini" onclick={ toggleSetEdit(s.ID) }>cancel</button>
					</form>
				</div>
			}
		</div>
	</div>

	<style>
		.sg-card { background: var(--bg); border-radius: 4px; padding: 0.6rem 0.85rem; }
		.sg-head {
			display:flex; justify-content:space-between; align-items:baseline;
			margin-bottom: 0.4rem; gap: 0.5rem; flex-wrap: wrap;
		}
		.sg-name { color: var(--green); font-weight: bold; font-size: 0.85rem; margin-right: 0.5rem; }
		.sg-vol { color: #ffd166; font-size: 0.7rem; }
		.sg-sets { display: flex; flex-direction: column; gap: 0.2rem; }
		.sg-set {
			padding: 0.25rem 0.5rem; background: var(--bg2);
			border-radius: 3px; font-size: 0.78rem;
		}
		.sg-display { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
		.sg-set-num { color: var(--text-muted); font-size: 0.6rem; letter-spacing: 0.15em; width: 30px; }
		.sg-set-detail { color: var(--green); flex: 1; }
		.sg-actions { display: flex; gap: 0.25rem; }
		.sg-edit-btn {
			background: transparent; border: none; color: var(--text-muted);
			cursor: pointer; padding: 0.1rem 0.4rem; font-size: 0.75rem;
			border-radius: 3px; transition: all 0.15s;
		}
		.sg-edit-btn:hover { color: var(--green); background: var(--green-faint); }
		.sg-edit-form {
			display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
		}
		.sg-edit-input {
			background: rgba(0,255,136,0.05); border: 1px solid var(--border);
			border-radius: 3px; color: var(--green); font-family: inherit;
			font-size: 0.75rem; padding: 0.2rem 0.4rem; outline: none;
			width: 70px;
		}
	</style>
}

func weightOrEmpty(s db.WorkoutSet) string {
	if s.WeightLbs.Valid {
		return fmt.Sprintf("%g", s.WeightLbs.Float64)
	}
	return ""
}

func toggleSetEdit(id int64) templ.ComponentScript {
	return templ.ComponentScript{
		Call: fmt.Sprintf("(function(){const r=document.getElementById('set-row-%d');const d=r.querySelector('.sg-display');const e=r.querySelector('.sg-edit-form');const editing=e.style.display!=='none';d.style.display=editing?'':'flex';e.style.display=editing?'none':'flex';})()", id),
	}
}

func prefillReps(n int) string {
	if n > 0 {
		return fmt.Sprintf("%d", n)
	}
	return ""
}

func prefillWeight(w float64) string {
	if w > 0 {
		return fmt.Sprintf("%g", w)
	}
	return ""
}
