package components

import (
	"database/sql"
	"fmt"
	"time"

	"pi-webpage/db"
)

type DayCell struct {
	Date          time.Time
	Key           string
	Day           int
	InMonth       bool
	IsToday       bool
	HasGym        bool
	HasCalories   bool
	Calories      float64
	CalorieBudget float64
	HasSteps      bool
	Steps         int64
	HasSleep      bool
	SleepHours    float64
	HasWeight     bool
	Weight        float64
	HasWorkout    bool
}

type FitnessModel struct {
	View        string // "month" | "week"
	Anchor      time.Time
	AnchorStr   string
	Label       string
	PrevStr     string
	NextStr     string
	TodayStr    string
	Cells       []DayCell
	GymDays     int     // gym checkins within the visible period
	AvgCalories float64 // average daily calories within the visible period
	AvgSteps    float64 // average daily steps within the visible period
	AvgSleep    float64 // average daily sleep hours within the visible period
	PeriodLabel string  // "MONTH" | "WEEK"
}

type DayDetail struct {
	Date         time.Time
	Checkins     []time.Time
	Nutrition    *db.NutritionDay
	Health       *db.HealthDay
	Body         *db.BodyMetric
	WorkoutSets  []db.WorkoutSet
}

templ FitnessPage(m FitnessModel) {
	@Layout("fitness") {
		<div class="page-header">
			<div>
				<div class="metric-label">fitness</div>
				<div class="metric-sub">calendar &middot; click a day for detail</div>
			</div>
			<div class="view-toggle">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/fitness?view=month&date=%s", m.AnchorStr)) }
					class={ "toggle-btn", templ.KV("active", m.View == "month") }
				>month</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/fitness?view=week&date=%s", m.AnchorStr)) }
					class={ "toggle-btn", templ.KV("active", m.View == "week") }
				>week</a>
			</div>
		</div>

		@FitnessGrid(m)

		<div class="legend">
			<div class="legend-item"><span class="dot gym"></span> gym</div>
			<div class="legend-item"><span class="dot cal-good"></span> cal: on budget</div>
			<div class="legend-item"><span class="dot cal-low"></span> cal: under</div>
			<div class="legend-item"><span class="dot cal-over"></span> cal: over</div>
			<div class="legend-item"><span class="dot steps-good"></span> 10k+ steps</div>
			<div class="legend-item"><span class="dot sleep-good"></span> 7h+ sleep</div>
			<div class="legend-item"><span class="dot weight"></span> weight logged</div>
			<div class="legend-item"><span class="dot workout"></span> workout</div>
		</div>

		<div class="period-stats">
			<div class="stat-box">
				<div class="stat-label">GYM DAYS / { m.PeriodLabel }</div>
				<div class="stat-value gym-color">{ fmt.Sprintf("%d", m.GymDays) }</div>
			</div>
			<div class="stat-box">
				<div class="stat-label">AVG CALORIES / { m.PeriodLabel }</div>
				<div class="stat-value">
					if m.AvgCalories > 0 {
						{ fmt.Sprintf("%.0f", m.AvgCalories) }
					} else {
						—
					}
				</div>
			</div>
			<div class="stat-box">
				<div class="stat-label">AVG STEPS / { m.PeriodLabel }</div>
				<div class="stat-value steps-color">
					if m.AvgSteps > 0 {
						{ fmt.Sprintf("%.0f", m.AvgSteps) }
					} else {
						—
					}
				</div>
			</div>
			<div class="stat-box">
				<div class="stat-label">AVG SLEEP / { m.PeriodLabel }</div>
				<div class="stat-value sleep-color">
					if m.AvgSleep > 0 {
						{ fmt.Sprintf("%.1fh", m.AvgSleep) }
					} else {
						—
					}
				</div>
			</div>
		</div>

		<div id="day-detail" style="margin-top: 1.25rem;"></div>

		<style>
			.page-header {
				display:flex; align-items:center; justify-content:space-between;
				margin-bottom:1rem; gap:0.75rem; flex-wrap:wrap;
			}
			.view-toggle { display:flex; gap:0.25rem; }
			.toggle-btn {
				color: var(--text-muted); text-decoration:none;
				font-size:0.7rem; letter-spacing:0.15em;
				padding:0.3rem 0.75rem; border:1px solid var(--border);
				border-radius:4px; transition: all 0.15s;
			}
			.toggle-btn:hover { color: var(--green); }
			.toggle-btn.active { color: var(--green); background: var(--green-faint); border-color: var(--green-dim); }

			.cal-nav {
				display:flex; align-items:center; justify-content:space-between;
				margin-bottom: 0.75rem;
			}
			.cal-nav-label {
				color: var(--green); font-size: 0.85rem; letter-spacing: 0.15em;
				font-weight: bold; text-transform: uppercase;
			}
			.cal-nav-btn {
				color: var(--text-muted); text-decoration:none;
				border: 1px solid var(--border); border-radius: 4px;
				padding: 0.2rem 0.6rem; font-size: 0.85rem;
				transition: all 0.15s;
			}
			.cal-nav-btn:hover { color: var(--green); background: var(--green-faint); }

			.cal-grid {
				display:grid; grid-template-columns: repeat(7, 1fr);
				gap: 4px;
				background: var(--bg2);
				border: 1px solid var(--border);
				border-radius: 6px;
				padding: 6px;
			}
			.cal-head {
				font-size: 0.55rem; letter-spacing: 0.2em;
				color: var(--text-muted); text-align: center;
				padding: 0.3rem 0;
			}
			.cal-day {
				background: var(--bg);
				border-radius: 4px;
				min-height: 70px;
				padding: 0.4rem 0.5rem;
				cursor: pointer;
				display: flex; flex-direction: column;
				gap: 0.3rem;
				border: 1px solid transparent;
				transition: all 0.15s;
				position: relative;
			}
			.cal-day:hover {
				border-color: var(--green-dim);
				box-shadow: 0 0 8px rgba(0,255,136,0.15);
			}
			.cal-day.out-month { opacity: 0.3; }
			.cal-day.today {
				border-color: var(--green);
				box-shadow: inset 0 0 0 1px var(--green), 0 0 12px rgba(0,255,136,0.2);
			}
			.cal-day.selected {
				background: var(--green-faint);
				border-color: var(--green);
			}
			.cal-day-num {
				font-size: 0.75rem; font-weight: bold;
				color: var(--green); line-height: 1;
			}
			.out-month .cal-day-num { color: var(--text-muted); }
			.cal-indicators {
				display:flex; gap: 0.25rem; margin-top: auto;
				flex-wrap: wrap; align-items: center;
			}
			.dot {
				width: 6px; height: 6px; border-radius: 50%;
				display: inline-block;
			}
			.dot.gym { background: #00d4ff; box-shadow: 0 0 4px rgba(0,212,255,0.7); }
			.dot.cal-good { background: #00ff88; box-shadow: 0 0 4px rgba(0,255,136,0.6); }
			.dot.cal-low { background: #ffaa00; box-shadow: 0 0 4px rgba(255,170,0,0.6); }
			.dot.cal-over { background: #ff4422; box-shadow: 0 0 4px rgba(255,68,34,0.6); }
			.dot.steps-good { background: #ff9500; box-shadow: 0 0 4px rgba(255,149,0,0.7); }
			.dot.steps-low { background: #b06200; box-shadow: 0 0 4px rgba(176,98,0,0.5); }
			.dot.sleep-good { background: #af52de; box-shadow: 0 0 4px rgba(175,82,222,0.7); }
			.dot.sleep-ok { background: #7e3ca8; box-shadow: 0 0 4px rgba(126,60,168,0.6); }
			.dot.sleep-low { background: #4d2466; box-shadow: 0 0 4px rgba(77,36,102,0.5); }
			.dot.weight { background: #5ce1e6; box-shadow: 0 0 4px rgba(92,225,230,0.7); }
			.dot.workout { background: #ffd166; box-shadow: 0 0 4px rgba(255,209,102,0.7); }
			.cal-cal-num {
				font-size: 0.55rem; color: var(--text-muted);
				letter-spacing: 0.05em;
			}
			.legend {
				display:flex; gap: 1rem; flex-wrap: wrap;
				margin-top: 0.75rem; padding: 0.5rem 0.25rem;
			}
			.legend-item {
				display:flex; align-items:center; gap: 0.4rem;
				font-size: 0.6rem; letter-spacing: 0.15em;
				color: var(--text-muted); text-transform: uppercase;
			}
			.legend-item .dot { width: 8px; height: 8px; }
			.period-stats {
				display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 0.75rem; margin-top: 0.75rem;
			}
			.stat-box {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 0.85rem 1rem;
			}
			.stat-label {
				font-size: 0.6rem; letter-spacing: 0.2em;
				color: var(--text-muted);
			}
			.stat-value {
				color: var(--green); font-size: 1.4rem; font-weight: bold;
				margin-top: 0.3rem; line-height: 1;
			}
			.stat-value.gym-color { color: #00d4ff; }
			.stat-value.steps-color { color: #ff9500; }
			.stat-value.sleep-color { color: #af52de; }
			@media (max-width: 600px) {
				.cal-day { min-height: 50px; padding: 0.25rem 0.3rem; gap: 0.2rem; }
				.cal-day-num { font-size: 0.65rem; }
				.cal-head { font-size: 0.5rem; }
				.cal-cal-num { display:none; }
				.dot { width: 5px; height: 5px; }
			}

			.detail-card {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 1.25rem;
			}
			.detail-head {
				display:flex; justify-content:space-between; align-items:baseline;
				margin-bottom: 1rem; padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--border);
			}
			.detail-date {
				color: var(--green); font-size: 1rem; font-weight: bold;
				letter-spacing: 0.1em;
			}
			.macro-row {
				display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
				gap: 0.75rem; margin-top: 0.75rem;
			}
			.macro-item {
				background: var(--bg); border-radius: 4px; padding: 0.6rem 0.75rem;
				border: 1px solid var(--border);
			}
			.macro-name { font-size: 0.55rem; letter-spacing: 0.2em; color: var(--text-muted); }
			.macro-value { font-size: 1rem; color: var(--green); font-weight: bold; margin-top: 0.2rem; }
			.macro-bar { height: 3px; background: rgba(0,255,136,0.1); border-radius: 2px; margin-top: 0.4rem; overflow: hidden; }
			.macro-bar-fill { height: 100%; background: var(--green); border-radius: 2px; box-shadow: 0 0 6px rgba(0,255,136,0.4); }
			.macro-bar-fill.over { background: #ff4422; box-shadow: 0 0 6px rgba(255,68,34,0.4); }
			.macro-budget { font-size: 0.55rem; color: var(--text-muted); margin-top: 0.3rem; }
			.macro-value.steps-color { color: #ff9500; }

			.sleep-total {
				display:flex; align-items:baseline; gap: 0.6rem;
				margin-bottom: 0.6rem;
			}
			.sleep-total-value { font-size: 1.4rem; font-weight: bold; }
			.sleep-color { color: #af52de; }

			.sleep-bar {
				display:flex; height: 14px; background: var(--bg);
				border: 1px solid var(--border); border-radius: 4px;
				overflow: hidden;
			}
			.sleep-seg { height: 100%; }
			.seg-deep  { background: #5e34a8; }
			.seg-rem   { background: #af52de; }
			.seg-core  { background: #c896e6; }
			.seg-awake { background: #6b6b6b; }

			.sleep-legend {
				display:flex; gap: 0.9rem; flex-wrap: wrap;
				margin-top: 0.5rem;
			}
			.sleep-leg-item {
				display:inline-flex; align-items:center; gap: 0.35rem;
				font-size: 0.65rem; color: var(--text-muted);
				letter-spacing: 0.1em; text-transform: uppercase;
			}
			.sleep-leg-dot {
				width: 8px; height: 8px; border-radius: 2px;
				display: inline-block;
			}

			.checkin-list { margin-top: 0.5rem; }
			.checkin-time {
				display: inline-block; padding: 0.25rem 0.6rem;
				background: var(--green-faint); border: 1px solid var(--green-dim);
				border-radius: 4px; color: var(--green); font-size: 0.7rem;
				letter-spacing: 0.1em; margin-right: 0.5rem; margin-bottom: 0.4rem;
			}
			.detail-empty {
				color: var(--text-muted); font-size: 0.75rem;
				text-align: center; padding: 1.5rem 0;
				letter-spacing: 0.05em;
			}
		</style>
	}
}

templ FitnessGrid(m FitnessModel) {
	<div id="fitness-grid">
		<div class="cal-nav">
			<a class="cal-nav-btn" href={ templ.SafeURL(fmt.Sprintf("/fitness?view=%s&date=%s", m.View, m.PrevStr)) }>&lt;</a>
			<span class="cal-nav-label">{ m.Label }</span>
			<a class="cal-nav-btn" href={ templ.SafeURL(fmt.Sprintf("/fitness?view=%s&date=%s", m.View, m.NextStr)) }>&gt;</a>
		</div>
		<div class="cal-grid">
			<div class="cal-head">SUN</div>
			<div class="cal-head">MON</div>
			<div class="cal-head">TUE</div>
			<div class="cal-head">WED</div>
			<div class="cal-head">THU</div>
			<div class="cal-head">FRI</div>
			<div class="cal-head">SAT</div>
			for _, c := range m.Cells {
				@dayCell(c)
			}
		</div>
	</div>
}

templ dayCell(c DayCell) {
	<div
		class={ "cal-day", templ.KV("out-month", !c.InMonth), templ.KV("today", c.IsToday) }
		hx-get={ fmt.Sprintf("/fitness/day?date=%s", c.Key) }
		hx-target="#day-detail"
		hx-swap="innerHTML"
		_="on click take .selected for me from .cal-day"
	>
		<span class="cal-day-num">{ fmt.Sprintf("%d", c.Day) }</span>
		<div class="cal-indicators">
			if c.HasGym {
				<span class="dot gym" title="gym checkin"></span>
			}
			if c.HasCalories {
				<span class={ "dot", calorieClass(c.Calories, c.CalorieBudget) } title="calories logged"></span>
			}
			if c.HasSteps {
				<span class={ "dot", stepsClass(c.Steps) } title="steps"></span>
			}
			if c.HasSleep {
				<span class={ "dot", sleepClass(c.SleepHours) } title="sleep"></span>
			}
			if c.HasWeight {
				<span class="dot weight" title="weight logged"></span>
			}
			if c.HasWorkout {
				<span class="dot workout" title="workout"></span>
			}
		</div>
	</div>
}

func stepsClass(s int64) string {
	if s >= 10000 {
		return "steps-good"
	}
	return "steps-low"
}

func sleepClass(h float64) string {
	if h >= 7 {
		return "sleep-good"
	}
	if h >= 5.5 {
		return "sleep-ok"
	}
	return "sleep-low"
}

func calorieClass(cal, budget float64) string {
	if budget <= 0 {
		return "cal-good"
	}
	if cal > budget*1.1 {
		return "cal-over"
	}
	if cal < budget*0.6 {
		return "cal-low"
	}
	return "cal-good"
}

templ DayDetailCard(d DayDetail) {
	<div class="detail-card">
		<div class="detail-head">
			<span class="detail-date">{ d.Date.Format("Monday, Jan 2") }</span>
			<span class="metric-sub">{ d.Date.Format("2006") }</span>
		</div>

		<div>
			<div class="metric-label" style="margin-bottom:0.5rem;">GYM</div>
			if len(d.Checkins) > 0 {
				<div class="checkin-list">
					for _, t := range d.Checkins {
						<span class="checkin-time">&#9632; { t.Format("3:04 PM") }</span>
					}
				</div>
			} else {
				<div class="detail-empty">no checkin</div>
			}
		</div>

		<div style="margin-top: 1rem;">
			<div class="metric-label" style="margin-bottom:0.5rem;">WORKOUT</div>
			if len(d.WorkoutSets) > 0 {
				@detailWorkoutList(d.WorkoutSets)
			} else {
				<div class="detail-empty">no workout logged</div>
			}
		</div>

		<div style="margin-top: 1rem;">
			<div class="metric-label" style="margin-bottom:0.5rem;">NUTRITION</div>
			if d.Nutrition != nil && d.Nutrition.Calories.Valid {
				<div class="macro-row">
					@macroItem("CALORIES", d.Nutrition.Calories.Float64, d.Nutrition.CalorieBudget, "kcal")
					@macroItem("PROTEIN", d.Nutrition.ProteinG.Float64, d.Nutrition.ProteinBudgetG, "g")
					@macroItem("CARBS", d.Nutrition.CarbG.Float64, d.Nutrition.CarbBudgetG, "g")
					@macroItem("FAT", d.Nutrition.FatG.Float64, d.Nutrition.FatBudgetG, "g")
					@macroItem("FIBRE", d.Nutrition.FibreG.Float64, d.Nutrition.FibreBudgetG, "g")
				</div>
			} else {
				<div class="detail-empty">no nutrition data</div>
			}
		</div>

		<div style="margin-top: 1rem;">
			<div class="metric-label" style="margin-bottom:0.5rem;">ACTIVITY</div>
			if d.Health != nil && (d.Health.Steps.Valid || d.Health.ActiveCalories.Valid || d.Health.RestingHR.Valid) {
				<div class="macro-row">
					if d.Health.Steps.Valid {
						<div class="macro-item">
							<div class="macro-name">STEPS</div>
							<div class="macro-value steps-color">{ fmt.Sprintf("%d", d.Health.Steps.Int64) }</div>
						</div>
					}
					if d.Health.ActiveCalories.Valid {
						<div class="macro-item">
							<div class="macro-name">ACTIVE CAL</div>
							<div class="macro-value">{ fmt.Sprintf("%.0f kcal", d.Health.ActiveCalories.Float64) }</div>
						</div>
					}
					if d.Health.RestingHR.Valid {
						<div class="macro-item">
							<div class="macro-name">RESTING HR</div>
							<div class="macro-value">{ fmt.Sprintf("%.0f bpm", d.Health.RestingHR.Float64) }</div>
						</div>
					}
				</div>
			} else {
				<div class="detail-empty">no activity data</div>
			}
		</div>

		<div style="margin-top: 1rem;">
			<div class="metric-label" style="margin-bottom:0.5rem;">BODY</div>
			if d.Body != nil && (d.Body.WeightLbs.Valid || d.Body.BfPercent.Valid) {
				<div class="macro-row">
					if d.Body.WeightLbs.Valid {
						<div class="macro-item">
							<div class="macro-name">WEIGHT</div>
							<div class="macro-value" style="color: #5ce1e6;">{ fmt.Sprintf("%.1f lb", d.Body.WeightLbs.Float64) }</div>
						</div>
					}
					if d.Body.BfPercent.Valid {
						<div class="macro-item">
							<div class="macro-name">BODY FAT</div>
							<div class="macro-value" style="color: #ff70b3;">{ fmt.Sprintf("%.1f%%", d.Body.BfPercent.Float64) }</div>
						</div>
					}
				</div>
			} else {
				<div class="detail-empty">no body metrics</div>
			}
		</div>

		<div style="margin-top: 1rem;">
			<div class="metric-label" style="margin-bottom:0.5rem;">SLEEP</div>
			if d.Health != nil && d.Health.SleepAsleepH.Valid && d.Health.SleepAsleepH.Float64 > 0 {
				<div class="sleep-total">
					<span class="sleep-total-value sleep-color">{ fmt.Sprintf("%.1fh", d.Health.SleepAsleepH.Float64) }</span>
					<span class="metric-sub">total asleep</span>
				</div>
				@sleepStages(d.Health)
			} else {
				<div class="detail-empty">no sleep data</div>
			}
		</div>
	</div>
}

templ sleepStages(h *db.HealthDay) {
	<div class="sleep-bar">
		if h.SleepDeepH.Valid && h.SleepDeepH.Float64 > 0 {
			<div class="sleep-seg seg-deep" style={ sleepSegWidth(h, h.SleepDeepH.Float64) } title={ fmt.Sprintf("deep %.1fh", h.SleepDeepH.Float64) }></div>
		}
		if h.SleepRemH.Valid && h.SleepRemH.Float64 > 0 {
			<div class="sleep-seg seg-rem" style={ sleepSegWidth(h, h.SleepRemH.Float64) } title={ fmt.Sprintf("rem %.1fh", h.SleepRemH.Float64) }></div>
		}
		if h.SleepCoreH.Valid && h.SleepCoreH.Float64 > 0 {
			<div class="sleep-seg seg-core" style={ sleepSegWidth(h, h.SleepCoreH.Float64) } title={ fmt.Sprintf("core %.1fh", h.SleepCoreH.Float64) }></div>
		}
		if h.SleepAwakeH.Valid && h.SleepAwakeH.Float64 > 0 {
			<div class="sleep-seg seg-awake" style={ sleepSegWidth(h, h.SleepAwakeH.Float64) } title={ fmt.Sprintf("awake %.1fh", h.SleepAwakeH.Float64) }></div>
		}
	</div>
	<div class="sleep-legend">
		if h.SleepDeepH.Valid && h.SleepDeepH.Float64 > 0 {
			<span class="sleep-leg-item"><span class="sleep-leg-dot seg-deep"></span>deep { fmt.Sprintf("%.1fh", h.SleepDeepH.Float64) }</span>
		}
		if h.SleepRemH.Valid && h.SleepRemH.Float64 > 0 {
			<span class="sleep-leg-item"><span class="sleep-leg-dot seg-rem"></span>rem { fmt.Sprintf("%.1fh", h.SleepRemH.Float64) }</span>
		}
		if h.SleepCoreH.Valid && h.SleepCoreH.Float64 > 0 {
			<span class="sleep-leg-item"><span class="sleep-leg-dot seg-core"></span>core { fmt.Sprintf("%.1fh", h.SleepCoreH.Float64) }</span>
		}
		if h.SleepAwakeH.Valid && h.SleepAwakeH.Float64 > 0 {
			<span class="sleep-leg-item"><span class="sleep-leg-dot seg-awake"></span>awake { fmt.Sprintf("%.1fh", h.SleepAwakeH.Float64) }</span>
		}
	</div>
}

templ detailWorkoutList(sets []db.WorkoutSet) {
	<div class="workout-mini-list">
		for _, e := range groupWorkoutByExercise(sets) {
			<div class="workout-mini-card">
				<div class="workout-mini-head">
					<span class="workout-mini-name">{ e.ExerciseName }</span>
					if e.BodyPart != "" {
						<span class="wg-bodypart">{ e.BodyPart }</span>
					}
				</div>
				<div class="workout-mini-sets">
					for _, s := range e.Sets {
						<span class="workout-mini-set">
							{ fmt.Sprintf("%d", s.Reps) }
							if s.WeightLbs.Valid {
								&nbsp;@&nbsp;{ fmt.Sprintf("%.0fL", s.WeightLbs.Float64) }
							}
						</span>
					}
				</div>
			</div>
		}
	</div>
	<style>
		.workout-mini-list { display: flex; flex-direction: column; gap: 0.5rem; }
		.workout-mini-card { background: var(--bg); border-radius: 4px; padding: 0.5rem 0.75rem; }
		.workout-mini-head { display:flex; gap: 0.5rem; align-items: baseline; margin-bottom: 0.3rem; }
		.workout-mini-name { color: var(--green); font-size: 0.8rem; font-weight: bold; }
		.workout-mini-sets { display: flex; gap: 0.4rem; flex-wrap: wrap; }
		.workout-mini-set {
			padding: 0.15rem 0.5rem; background: var(--bg2);
			border: 1px solid var(--border); border-radius: 3px;
			font-size: 0.7rem; color: var(--green);
		}
	</style>
}

func groupWorkoutByExercise(sets []db.WorkoutSet) []WorkoutGroup {
	groupMap := map[int64]*WorkoutGroup{}
	var order []int64
	for _, s := range sets {
		g, ok := groupMap[s.ExerciseID]
		if !ok {
			bp := ""
			if s.BodyPart.Valid {
				bp = s.BodyPart.String
			}
			g = &WorkoutGroup{
				ExerciseID:   s.ExerciseID,
				ExerciseName: s.ExerciseName,
				BodyPart:     bp,
			}
			groupMap[s.ExerciseID] = g
			order = append(order, s.ExerciseID)
		}
		g.Sets = append(g.Sets, s)
	}
	out := make([]WorkoutGroup, 0, len(order))
	for _, id := range order {
		out = append(out, *groupMap[id])
	}
	return out
}

func sleepSegWidth(h *db.HealthDay, segHours float64) string {
	total := 0.0
	for _, v := range []sql.NullFloat64{h.SleepDeepH, h.SleepRemH, h.SleepCoreH, h.SleepAwakeH} {
		if v.Valid {
			total += v.Float64
		}
	}
	if total == 0 {
		return "flex: 0"
	}
	return fmt.Sprintf("flex: %.4f", segHours/total)
}

templ macroItem(label string, value float64, budget sql.NullFloat64, unit string) {
	<div class="macro-item">
		<div class="macro-name">{ label }</div>
		<div class="macro-value">{ fmt.Sprintf("%.0f%s", value, unit) }</div>
		<div class="macro-bar">
			if budget.Valid && budget.Float64 > 0 {
				<div
					class={ "macro-bar-fill", templ.KV("over", value > budget.Float64*1.1) }
					style={ fmt.Sprintf("width: %.0f%%", clamp(value/budget.Float64*100, 0, 100)) }
				></div>
			}
		</div>
		if budget.Valid && budget.Float64 > 0 {
			<div class="macro-budget">{ fmt.Sprintf("budget %.0f%s", budget.Float64, unit) }</div>
		}
	</div>
}

func clamp(v, lo, hi float64) float64 {
	if v < lo { return lo }
	if v > hi { return hi }
	return v
}
