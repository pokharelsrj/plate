package components

import "time"

templ StatsPage(s StatsData, fetchedAt time.Time) {
	@Layout("stats") {
		<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.25rem;">
			<div>
				<div class="metric-label" style="margin-bottom:0.2rem;">system metrics</div>
				<div class="metric-sub">raspberry pi 5</div>
			</div>
			<div style="display:flex; align-items:center; gap:0.75rem;">
				<span id="fetched-at" class="metric-sub">{ fetchedAt.Format("15:04:05") }</span>
				<button
					class="btn-terminal"
					hx-get="/stats/data"
					hx-target="#stats-grid"
					hx-swap="outerHTML"
					_="on htmx:afterRequest set #fetched-at.innerText to (new Date()).toLocaleTimeString()"
				>
					<span class="spinner"></span>
					<span class="refresh-text">&#8635; refresh</span>
				</button>
			</div>
		</div>
		@StatsPartial(s)
	}
}
