package components

import "fmt"

templ TrendsPage(rangeDays int) {
	@Layout("trends") {
		<div id="trends-root" data-initial-range={ fmt.Sprintf("%d", rangeDays) }>
			<div class="trends-header">
				<div>
					<div class="metric-label">trends</div>
					<div class="metric-sub">historical view</div>
				</div>
				<div class="range-selector">
					<button class="range-btn" data-range="7">7d</button>
					<button class="range-btn" data-range="30">30d</button>
					<button class="range-btn" data-range="90">90d</button>
				</div>
			</div>

			<div class="summary-row">
				<div class="summary-card">
					<div class="metric-label">avg calories</div>
					<div class="summary-value" id="sum-cal">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">gym sessions</div>
					<div class="summary-value sum-gym" id="sum-gym">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">avg steps</div>
					<div class="summary-value sum-steps" id="sum-steps">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">avg sleep</div>
					<div class="summary-value sum-sleep" id="sum-sleep">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">latest weight</div>
					<div class="summary-value sum-weight" id="sum-weight">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">latest bf %</div>
					<div class="summary-value sum-bf" id="sum-bf">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">workouts</div>
					<div class="summary-value sum-workouts" id="sum-workouts">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">total sets</div>
					<div class="summary-value sum-sets" id="sum-sets">—</div>
				</div>
				<div class="summary-card">
					<div class="metric-label">range</div>
					<div class="summary-value" id="sum-range">—</div>
				</div>
			</div>

			<div class="chart-card">
				<div class="chart-title">CALORIES &middot; daily intake</div>
				<div class="chart-wrap"><canvas id="cal-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">MACROS &middot; protein / carbs / fat / fibre</div>
				<div class="chart-wrap"><canvas id="macro-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">GYM &middot; weekly frequency</div>
				<div class="chart-wrap"><canvas id="gym-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">STEPS &middot; daily total</div>
				<div class="chart-wrap"><canvas id="steps-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">SLEEP &middot; stages (deep / rem / core / awake)</div>
				<div class="chart-wrap"><canvas id="sleep-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">RESTING HEART RATE</div>
				<div class="chart-wrap"><canvas id="hr-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">WEIGHT (LBS) &middot; weekly average</div>
				<div class="chart-wrap"><canvas id="weight-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">BODY FAT %</div>
				<div class="chart-wrap"><canvas id="bf-chart"></canvas></div>
			</div>
			<div class="chart-card">
				<div class="chart-title">SETS BY BODY PART</div>
				<div class="chart-wrap"><canvas id="bodypart-chart"></canvas></div>
			</div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
		<script>
			(function() {
				const GREEN = '#00ff88', GREEN_DIM = '#00cc6a';
				const MUTED = 'rgba(0,255,136,0.4)', GRID = 'rgba(0,255,136,0.08)';
				Chart.defaults.color = MUTED;
				Chart.defaults.font.family = "'Courier New', Courier, monospace";
				Chart.defaults.font.size = 10;

				let calChart, macroChart, gymChart, stepsChart, sleepChart, hrChart, weightChart, bfChart, bodyPartChart;

				function fmtDate(s) {
					const d = new Date(s + 'T00:00:00');
					return d.toLocaleDateString('en-US', {month:'short', day:'numeric'});
				}
				function weekKey(dateStr) {
					const d = new Date(dateStr + 'T00:00:00');
					const onejan = new Date(d.getFullYear(), 0, 1);
					const week = Math.ceil((((d - onejan) / 86400000) + onejan.getDay() + 1) / 7);
					return d.getFullYear() + '-W' + String(week).padStart(2, '0');
				}
				function chartOptions(commonScale, showLegend) {
					return {
						responsive: true,
						maintainAspectRatio: false,
						interaction: { mode: 'index', intersect: false },
						plugins: {
							legend: { display: !!showLegend, labels: { color: MUTED, boxWidth: 10 } },
							tooltip: {
								backgroundColor: '#0d1117',
								borderColor: GREEN_DIM,
								borderWidth: 1,
								titleColor: GREEN,
								bodyColor: GREEN,
							},
						},
						scales: { x: commonScale, y: commonScale },
					};
				}

				async function loadTrends(days) {
					document.querySelectorAll('.range-btn').forEach(b => {
						b.classList.toggle('active', parseInt(b.dataset.range) === days);
					});
					const r = await fetch('/trends/data?range=' + days);
					const data = await r.json();
					render(data);
				}

				function render(data) {
					const labels = data.points.map(p => fmtDate(p.date));
					const cals = data.points.map(p => p.calories);

					document.getElementById('sum-cal').textContent =
						data.avg_calories ? Math.round(data.avg_calories) : '—';
					document.getElementById('sum-gym').textContent = data.gym_days;
					document.getElementById('sum-steps').textContent =
						data.avg_steps ? Math.round(data.avg_steps).toLocaleString() : '—';
					document.getElementById('sum-sleep').textContent =
						data.avg_sleep ? data.avg_sleep.toFixed(1) + 'h' : '—';
					document.getElementById('sum-weight').textContent =
						data.latest_weight ? data.latest_weight.toFixed(1) + ' lb' : '—';
					document.getElementById('sum-bf').textContent =
						data.latest_bf ? data.latest_bf.toFixed(1) + '%' : '—';
					document.getElementById('sum-workouts').textContent = data.workout_days || 0;
					document.getElementById('sum-sets').textContent = data.total_sets || 0;
					document.getElementById('sum-range').textContent = data.range_days + ' days';

					const commonScale = {
						grid: { color: GRID, drawBorder: false },
						ticks: { color: MUTED },
					};

					if (calChart) calChart.destroy();
					const calDatasets = [{
						label: 'Calories',
						data: cals,
						borderColor: GREEN,
						backgroundColor: 'rgba(0,255,136,0.1)',
						pointBackgroundColor: GREEN,
						pointRadius: 3,
						borderWidth: 2,
						tension: 0.3,
						fill: true,
						spanGaps: true,
					}];
					if (data.calorie_budget) {
						calDatasets.push({
							label: 'Budget',
							data: labels.map(()=>data.calorie_budget),
							borderColor: 'rgba(255,170,0,0.5)',
							borderDash: [4,4],
							borderWidth: 1,
							pointRadius: 0,
						});
					}
					calChart = new Chart(document.getElementById('cal-chart'), {
						type: 'line',
						data: { labels, datasets: calDatasets },
						options: chartOptions(commonScale),
					});

					if (macroChart) macroChart.destroy();
					macroChart = new Chart(document.getElementById('macro-chart'), {
						type: 'line',
						data: {
							labels,
							datasets: [
								{ label:'Protein', data: data.points.map(p=>p.protein), borderColor:'#00ff88', borderWidth:1.5, pointRadius:2, tension:0.3, spanGaps:true },
								{ label:'Carbs',   data: data.points.map(p=>p.carb),    borderColor:'#FAC734', borderWidth:1.5, pointRadius:2, tension:0.3, spanGaps:true },
								{ label:'Fat',     data: data.points.map(p=>p.fat),     borderColor:'#FF6B6B', borderWidth:1.5, pointRadius:2, tension:0.3, spanGaps:true },
								{ label:'Fibre',   data: data.points.map(p=>p.fibre),   borderColor:'#8BC249', borderWidth:1.5, pointRadius:2, tension:0.3, spanGaps:true },
							],
						},
						options: chartOptions(commonScale, true),
					});

					const weekly = {};
					data.points.forEach(p => {
						const k = weekKey(p.date);
						weekly[k] = (weekly[k] || 0) + (p.gym ? 1 : 0);
					});
					const weekLabels = Object.keys(weekly);
					const weekVals = weekLabels.map(k => weekly[k]);
					if (gymChart) gymChart.destroy();
					gymChart = new Chart(document.getElementById('gym-chart'), {
						type: 'bar',
						data: {
							labels: weekLabels,
							datasets: [{
								label: 'Sessions',
								data: weekVals,
								backgroundColor: 'rgba(0,212,255,0.4)',
								borderColor: '#00d4ff',
								borderWidth: 1,
							}],
						},
						options: chartOptions(commonScale),
					});

					// Steps
					if (stepsChart) stepsChart.destroy();
					stepsChart = new Chart(document.getElementById('steps-chart'), {
						type: 'bar',
						data: {
							labels,
							datasets: [{
								label: 'Steps',
								data: data.points.map(p => p.steps),
								backgroundColor: 'rgba(255,149,0,0.5)',
								borderColor: '#ff9500',
								borderWidth: 1,
							}],
						},
						options: chartOptions(commonScale),
					});

					// Sleep stages stacked bar
					if (sleepChart) sleepChart.destroy();
					sleepChart = new Chart(document.getElementById('sleep-chart'), {
						type: 'bar',
						data: {
							labels,
							datasets: [
								{ label:'Deep',  data: data.points.map(p=>p.sleep_deep),  backgroundColor:'#5e34a8', stack:'s' },
								{ label:'REM',   data: data.points.map(p=>p.sleep_rem),   backgroundColor:'#af52de', stack:'s' },
								{ label:'Core',  data: data.points.map(p=>p.sleep_core),  backgroundColor:'#c896e6', stack:'s' },
								{ label:'Awake', data: data.points.map(p=>p.sleep_awake), backgroundColor:'#6b6b6b', stack:'s' },
							],
						},
						options: {
							responsive: true, maintainAspectRatio: false,
							interaction: { mode: 'index', intersect: false },
							plugins: {
								legend: { labels: { color: MUTED, boxWidth: 10 } },
								tooltip: {
									backgroundColor: '#0d1117', borderColor: GREEN_DIM, borderWidth: 1,
									titleColor: GREEN, bodyColor: GREEN,
								},
							},
							scales: {
								x: { ...commonScale, stacked: true },
								y: { ...commonScale, stacked: true, title: { display: true, text: 'hours', color: MUTED } },
							},
						},
					});

					// Resting HR
					if (hrChart) hrChart.destroy();
					hrChart = new Chart(document.getElementById('hr-chart'), {
						type: 'line',
						data: {
							labels,
							datasets: [{
								label: 'Resting HR',
								data: data.points.map(p => p.resting_hr),
								borderColor: '#ff4488',
								backgroundColor: 'rgba(255,68,136,0.1)',
								borderWidth: 2,
								pointRadius: 2,
								tension: 0.3,
								spanGaps: true,
								fill: true,
							}],
						},
						options: chartOptions(commonScale),
					});

					// Weight — one point per week = average of that week's weigh-ins.
					// Points arrive chronologically, so the bucket order is chronological too.
					const wWeekly = {};
					const wWeekOrder = [];
					data.points.forEach(p => {
						if (p.weight_lbs == null) return;
						const k = weekKey(p.date);
						if (!wWeekly[k]) { wWeekly[k] = { sum: 0, count: 0, firstDate: p.date }; wWeekOrder.push(k); }
						wWeekly[k].sum += p.weight_lbs;
						wWeekly[k].count += 1;
					});
					const weightLabels = wWeekOrder.map(k => fmtDate(wWeekly[k].firstDate));
					const weightVals = wWeekOrder.map(k => wWeekly[k].sum / wWeekly[k].count);
					if (weightChart) weightChart.destroy();
					weightChart = new Chart(document.getElementById('weight-chart'), {
						type: 'line',
						data: {
							labels: weightLabels,
							datasets: [{
								label: 'Weekly avg weight (lb)',
								data: weightVals,
								borderColor: '#5ce1e6',
								backgroundColor: 'rgba(92,225,230,0.1)',
								borderWidth: 2,
								pointRadius: 3,
								tension: 0.3,
								spanGaps: true,
								fill: true,
							}],
						},
						options: chartOptions(commonScale),
					});

					// Body fat %
					if (bfChart) bfChart.destroy();
					bfChart = new Chart(document.getElementById('bf-chart'), {
						type: 'line',
						data: {
							labels,
							datasets: [{
								label: 'BF %',
								data: data.points.map(p => p.bf_percent),
								borderColor: '#ff70b3',
								backgroundColor: 'rgba(255,112,179,0.1)',
								borderWidth: 2,
								pointRadius: 3,
								tension: 0.3,
								spanGaps: true,
								fill: true,
							}],
						},
						options: chartOptions(commonScale),
					});

					// Sets by body part (doughnut)
					if (bodyPartChart) bodyPartChart.destroy();
					const bpData = data.sets_by_body_part || {};
					const bpLabels = Object.keys(bpData);
					const bpValues = bpLabels.map(k => bpData[k]);
					const bpColors = ['#ffd166','#06d6a0','#118ab2','#ef476f','#073b4c','#ab47bc','#ff9800','#90a4ae'];
					bodyPartChart = new Chart(document.getElementById('bodypart-chart'), {
						type: 'doughnut',
						data: {
							labels: bpLabels,
							datasets: [{
								data: bpValues,
								backgroundColor: bpLabels.map((_, i) => bpColors[i % bpColors.length]),
								borderColor: '#0d1117',
								borderWidth: 2,
							}],
						},
						options: {
							responsive: true, maintainAspectRatio: false,
							plugins: {
								legend: { position: 'right', labels: { color: MUTED, boxWidth: 10, font: { size: 10 } } },
								tooltip: {
									backgroundColor: '#0d1117', borderColor: GREEN_DIM, borderWidth: 1,
									titleColor: GREEN, bodyColor: GREEN,
								},
							},
						},
					});
				}

				document.querySelectorAll('.range-btn').forEach(b => {
					b.addEventListener('click', () => loadTrends(parseInt(b.dataset.range)));
				});

				const initial = parseInt(document.getElementById('trends-root').dataset.initialRange) || 30;
				loadTrends(initial);
			})();
		</script>

		<style>
			.trends-header {
				display:flex; align-items:center; justify-content:space-between;
				margin-bottom: 1rem; gap: 0.75rem; flex-wrap: wrap;
			}
			.range-selector { display:flex; gap: 0.25rem; }
			.range-btn {
				background: transparent; border: 1px solid var(--border);
				color: var(--text-muted); font-family: inherit;
				font-size: 0.7rem; padding: 0.3rem 0.75rem;
				border-radius: 4px; cursor: pointer; letter-spacing: 0.1em;
				transition: all 0.15s;
			}
			.range-btn:hover { color: var(--green); }
			.range-btn.active { color: var(--green); background: var(--green-faint); border-color: var(--green-dim); }

			.summary-row {
				display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
				gap: 0.75rem; margin-bottom: 1rem;
			}
			.summary-card {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 0.75rem 1rem;
			}
			.summary-value {
				color: var(--green); font-size: 1.4rem; font-weight: bold;
				margin-top: 0.25rem; line-height: 1;
			}
			.summary-value.sum-gym { color: #00d4ff; }
			.summary-value.sum-steps { color: #ff9500; }
			.summary-value.sum-sleep { color: #af52de; }
			.summary-value.sum-weight { color: #5ce1e6; }
			.summary-value.sum-bf { color: #ff70b3; }
			.summary-value.sum-workouts { color: #ffd166; }
			.summary-value.sum-sets { color: #ffd166; }
			.chart-card {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1rem;
			}
			.chart-title {
				color: var(--text-muted); font-size: 0.65rem;
				letter-spacing: 0.2em; margin-bottom: 0.75rem;
			}
			.chart-wrap { height: 220px; position: relative; }
			@media (max-width: 600px) {
				.chart-wrap { height: 180px; }
				.chart-card { padding: 0.75rem; }
			}
		</style>
	}
}
