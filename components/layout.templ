package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="night">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } | pi</title>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/tailwindcss-cdn@3.4.16/tailwindcss.min.js"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://unpkg.com/hyperscript.org@0.9.14"></script>
			<style>
				:root {
					--green: #00ff88;
					--green-dim: #00cc6a;
					--green-faint: rgba(0,255,136,0.08);
					--bg: #080c10;
					--bg2: #0d1117;
					--bg3: #161b22;
					--border: rgba(0,255,136,0.15);
					--text-muted: rgba(0,255,136,0.4);
				}
				* { box-sizing: border-box; }
				body {
					background: var(--bg);
					color: var(--green);
					font-family: 'Courier New', Courier, monospace;
					min-height: 100vh;
				}
				.card-terminal {
					background: var(--bg2);
					border: 1px solid var(--border);
					border-radius: 6px;
					box-shadow: 0 0 20px rgba(0,255,136,0.04), inset 0 0 20px rgba(0,0,0,0.3);
				}
				.card-terminal:hover {
					border-color: rgba(0,255,136,0.3);
					box-shadow: 0 0 30px rgba(0,255,136,0.08);
					transition: all 0.2s ease;
				}
				.nav-bar {
					background: var(--bg2);
					border-bottom: 1px solid var(--border);
					padding: 0.75rem 1.5rem;
					display: flex;
					align-items: center;
					justify-content: space-between;
					flex-wrap: wrap;
					gap: 0.5rem;
				}
				.nav-logo {
					color: var(--green);
					font-weight: bold;
					font-size: 1rem;
					letter-spacing: 0.3em;
				}
				.nav-links { display: flex; gap: 0.25rem; align-items: center; flex-wrap: wrap; }
				.nav-link {
					color: var(--text-muted);
					text-decoration: none;
					font-size: 0.8rem;
					letter-spacing: 0.1em;
					padding: 0.3rem 0.75rem;
					border-radius: 4px;
					border: 1px solid transparent;
					transition: all 0.15s;
				}
				.nav-link:hover, .nav-link.active {
					color: var(--green);
					border-color: var(--border);
					background: var(--green-faint);
				}
				.nav-link.disabled { opacity: 0.25; cursor: not-allowed; pointer-events: none; }
				.nav-divider { width: 1px; height: 1rem; background: var(--border); margin: 0 0.5rem; }

				.nav-group { position: relative; }
				.nav-group-summary {
					cursor: pointer; list-style: none;
					display: inline-block;
				}
				.nav-group-summary::-webkit-details-marker { display: none; }
				.nav-group[open] > .nav-group-summary { color: var(--green); }
				.nav-dropdown {
					position: absolute; top: 100%; right: 0;
					margin-top: 0.4rem;
					background: var(--bg2); border: 1px solid var(--border);
					border-radius: 6px; padding: 0.3rem;
					display: flex; flex-direction: column; gap: 0.15rem;
					min-width: 160px;
					box-shadow: 0 4px 16px rgba(0,0,0,0.4), 0 0 8px rgba(0,255,136,0.04);
					z-index: 100;
				}
				.nav-dropdown-item {
					color: var(--text-muted); text-decoration: none;
					font-size: 0.8rem; letter-spacing: 0.1em;
					padding: 0.4rem 0.75rem; border-radius: 4px;
					background: transparent; border: none; font-family: inherit;
					text-align: left; cursor: pointer; transition: all 0.15s;
				}
				.nav-dropdown-item:hover { color: var(--green); background: var(--green-faint); }
				.nav-dropdown-item.active { color: var(--green); background: var(--green-faint); }
				.nav-dropdown-logout { color: rgba(255,80,80,0.5); }
				.nav-dropdown-logout:hover { color: rgba(255,80,80,0.9); background: rgba(255,80,80,0.08); }

				@media (max-width: 600px) {
					.nav-bar { padding: 0.6rem 1rem; }
					.nav-divider { display: none; }
					.nav-link { font-size: 0.7rem; padding: 0.25rem 0.5rem; }
					.nav-link.disabled { display: none; }
					.nav-dropdown { right: auto; left: 0; }
				}
				.btn-terminal {
					background: transparent;
					border: 1px solid var(--green-dim);
					color: var(--green);
					font-family: inherit;
					font-size: 0.75rem;
					letter-spacing: 0.1em;
					padding: 0.35rem 1rem;
					border-radius: 4px;
					cursor: pointer;
					transition: all 0.15s;
					display: inline-flex;
					align-items: center;
					gap: 0.4rem;
				}
				.btn-terminal:hover {
					background: var(--green-faint);
					box-shadow: 0 0 10px rgba(0,255,136,0.2);
				}
				.btn-logout {
					border-color: rgba(255,80,80,0.3);
					color: rgba(255,80,80,0.5);
				}
				.btn-logout:hover {
					background: rgba(255,80,80,0.08);
					color: rgba(255,80,80,0.9);
					border-color: rgba(255,80,80,0.6);
					box-shadow: 0 0 10px rgba(255,80,80,0.15);
				}
				.bar-track {
					height: 4px;
					background: rgba(0,255,136,0.1);
					border-radius: 2px;
					overflow: hidden;
				}
				.bar-fill {
					height: 100%;
					border-radius: 2px;
					background: linear-gradient(90deg, var(--green-dim), var(--green));
					box-shadow: 0 0 8px rgba(0,255,136,0.5);
					transition: width 0.4s ease;
				}
				.bar-fill.warn { background: linear-gradient(90deg, #cc8800, #ffaa00); box-shadow: 0 0 8px rgba(255,170,0,0.5); }
				.bar-fill.danger { background: linear-gradient(90deg, #cc2200, #ff4400); box-shadow: 0 0 8px rgba(255,68,0,0.5); }
				.metric-value { font-size: 2rem; font-weight: bold; letter-spacing: -0.02em; line-height: 1; }
				.metric-label { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--text-muted); }
				.metric-sub { font-size: 0.7rem; color: var(--text-muted); }
				.spinner { display: none; width: 12px; height: 12px; border: 2px solid var(--border); border-top-color: var(--green); border-radius: 50%; animation: spin 0.6s linear infinite; }
				.htmx-request .spinner { display: inline-block; }
				.htmx-request .refresh-text { display: none; }
				@keyframes spin { to { transform: rotate(360deg); } }
				.temp-warn { color: #ffaa00; }
				.temp-danger { color: #ff4422; }
				.scanline {
					position: fixed; top: 0; left: 0; right: 0; bottom: 0;
					background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
					pointer-events: none; z-index: 9999;
				}
			</style>
		</head>
		<body>
			<div class="scanline"></div>
			<div class="nav-bar">
				<span class="nav-logo">&#9632; PI</span>
				<nav class="nav-links">
					<a href="/" class={ "nav-link", navActive(title, "stats") }>pi</a>

					<details class="nav-group" open?={ inHealthGroup(title) }>
						<summary class={ "nav-link", "nav-group-summary", templ.KV("active", inHealthGroup(title)) }>health &#9662;</summary>
						<div class="nav-dropdown">
							<a href="/fitness" class={ "nav-dropdown-item", navActive(title, "fitness") }>calendar</a>
							<a href="/workout" class={ "nav-dropdown-item", navActive(title, "workout") }>workout</a>
							<a href="/exercises" class={ "nav-dropdown-item", navActive(title, "exercises") }>exercises</a>
							<a href="/body" class={ "nav-dropdown-item", navActive(title, "body") }>body</a>
						</div>
					</details>

					<a href="/trends" class={ "nav-link", navActive(title, "trends") }>trends</a>

					<details class="nav-group" open?={ inAdminGroup(title) }>
						<summary class={ "nav-link", "nav-group-summary", templ.KV("active", inAdminGroup(title)) }>more &#9662;</summary>
						<div class="nav-dropdown">
							<a href="/sync" class={ "nav-dropdown-item", navActive(title, "sync") }>sync status</a>
							<form method="POST" action="/logout" style="margin:0">
								<button type="submit" class="nav-dropdown-item nav-dropdown-logout">logout</button>
							</form>
						</div>
					</details>
				</nav>
			</div>
			<main style="padding: 1rem; max-width: 960px; margin: 0 auto;">
				{ children... }
			</main>
		</body>
	</html>
}

func navActive(title, page string) string {
	if title == page {
		return "active"
	}
	return ""
}

func inHealthGroup(title string) bool {
	return title == "fitness" || title == "workout" || title == "exercises" || title == "body"
}

func inAdminGroup(title string) bool {
	return title == "sync"
}
