package components

import (
	"fmt"

	"pi-webpage/db"
)

type ExercisesPageModel struct {
	BodyParts    []string
	BodyPartUses map[string]int
	Groups       []PickerGroup
	Counts       map[int64]int
	EditID       int64
	ErrorMsg     string
	OkMsg        string
}

templ ExercisesPage(m ExercisesPageModel) {
	@Layout("exercises") {
		<div class="page-header">
			<div>
				<div class="metric-label">exercises</div>
				<div class="metric-sub">manage your exercise library</div>
			</div>
		</div>

		if m.OkMsg != "" {
			<div class="form-ok">&#10003; { m.OkMsg }</div>
		}
		if m.ErrorMsg != "" {
			<div class="form-err">{ m.ErrorMsg }</div>
		}

		<details class="tag-manager">
			<summary>
				<span class="metric-label">TAGS</span>
				<span class="metric-sub">{ fmt.Sprintf("%d tags", len(m.BodyParts)) } &middot; tap to manage</span>
			</summary>
			<div class="tag-manager-body">
				<div class="tag-chips">
					for _, bp := range m.BodyParts {
						<span class="tag-chip">
							{ bp }
							if m.BodyPartUses[bp] > 0 {
								<span class="tag-chip-count">({ fmt.Sprintf("%d", m.BodyPartUses[bp]) })</span>
							}
							if m.BodyPartUses[bp] == 0 {
								<form method="POST" action="/exercises/tag/delete" style="margin:0; display:inline;"
									onsubmit={ templ.ComponentScript{Call: fmt.Sprintf("return confirm('Remove tag %q?')", bp)} }>
									<input type="hidden" name="name" value={ bp }/>
									<button type="submit" class="tag-chip-x" title="remove">×</button>
								</form>
							}
						</span>
					}
				</div>
				<form method="POST" action="/exercises/tag" class="tag-add-form">
					<input type="text" name="name" placeholder="new tag (e.g., glutes)" class="body-input" required maxlength="32"/>
					<button type="submit" class="btn-terminal">add tag</button>
				</form>
				<div class="metric-sub" style="margin-top: 0.5rem;">
					tags with exercises tagged to them cannot be removed
				</div>
			</div>
		</details>

		<form method="POST" action="/exercises" class="ex-add-form">
			<div class="form-title">NEW EXERCISE</div>
			<div class="ex-add-row">
				<label class="body-field" style="flex:2">
					<span class="metric-label">NAME</span>
					<input type="text" name="name" placeholder="e.g., Incline Dumbbell Press" class="body-input" required/>
				</label>
				<label class="body-field" style="flex:1">
					<span class="metric-label">BODY PART</span>
					<select name="body_part" class="body-input">
						<option value="">— select —</option>
						for _, bp := range m.BodyParts {
							<option value={ bp }>{ bp }</option>
						}
					</select>
				</label>
				<button type="submit" class="btn-terminal" style="align-self:end">add</button>
			</div>
		</form>

		<div class="metric-label" style="margin:1.5rem 0 0.5rem;">LIBRARY</div>

		if len(m.Groups) == 0 {
			<div class="detail-empty">no exercises yet — add one above</div>
		}

		<div class="ex-list">
			for _, g := range m.Groups {
				<div class="ex-bp-group">
					<div class="ex-bp-header">{ g.BodyPart }</div>
					<div class="ex-rows">
						for _, e := range g.Exercises {
							if m.EditID == e.ID {
								@exerciseEditRow(e, m.BodyParts)
							} else {
								@exerciseDisplayRow(e, m.Counts[e.ID])
							}
						}
					</div>
				</div>
			}
		</div>

		<style>
			.tag-manager {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; margin-bottom: 0.75rem;
			}
			.tag-manager summary {
				cursor: pointer; padding: 0.75rem 1rem;
				display: flex; justify-content: space-between; align-items: center;
				gap: 0.5rem; list-style: none;
			}
			.tag-manager summary::-webkit-details-marker { display: none; }
			.tag-manager[open] summary { border-bottom: 1px solid var(--border); }
			.tag-manager-body { padding: 1rem; }
			.tag-chips {
				display: flex; flex-wrap: wrap; gap: 0.4rem;
				margin-bottom: 0.75rem;
			}
			.tag-chip {
				display: inline-flex; align-items: center; gap: 0.35rem;
				background: var(--bg); border: 1px solid var(--border);
				border-radius: 14px; padding: 0.25rem 0.6rem;
				color: var(--green); font-size: 0.75rem; letter-spacing: 0.05em;
			}
			.tag-chip-count { color: var(--text-muted); font-size: 0.7rem; }
			.tag-chip-x {
				background: transparent; border: none;
				color: var(--text-muted); cursor: pointer;
				font-size: 0.95rem; padding: 0 0 0 0.15rem;
				line-height: 1; transition: color 0.15s;
			}
			.tag-chip-x:hover { color: #ff7766; }
			.tag-add-form {
				display: flex; gap: 0.5rem; flex-wrap: wrap;
			}
			.tag-add-form input { flex: 1; min-width: 180px; }

			.ex-add-form {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; padding: 1.25rem;
			}
			.ex-add-row {
				display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: end;
			}
			.ex-list { display:flex; flex-direction: column; gap: 0.75rem; }
			.ex-bp-group {
				background: var(--bg2); border: 1px solid var(--border);
				border-radius: 6px; overflow: hidden;
			}
			.ex-bp-header {
				background: var(--bg); padding: 0.5rem 1rem;
				font-size: 0.65rem; letter-spacing: 0.2em;
				color: #ffd166; text-transform: uppercase;
				border-bottom: 1px solid var(--border);
			}
			.ex-rows { display: flex; flex-direction: column; }
			.ex-row {
				display: flex; justify-content: space-between; align-items: center;
				padding: 0.6rem 1rem; border-bottom: 1px solid var(--border);
				gap: 0.75rem; flex-wrap: wrap;
			}
			.ex-row:last-child { border-bottom: none; }
			.ex-row-left { display: flex; align-items: center; gap: 0.6rem; flex: 1; }
			.ex-name { color: var(--green); font-size: 0.9rem; font-weight: bold; }
			.ex-count { color: var(--text-muted); font-size: 0.7rem; }
			.ex-actions { display: flex; gap: 0.4rem; }
			.btn-ex-edit, .btn-ex-del {
				background: transparent; border: 1px solid var(--border);
				color: var(--text-muted); font-family: inherit;
				font-size: 0.7rem; padding: 0.3rem 0.6rem;
				border-radius: 3px; cursor: pointer; letter-spacing: 0.1em;
				transition: all 0.15s; text-decoration: none;
			}
			.btn-ex-edit:hover { color: var(--green); border-color: var(--green-dim); }
			.btn-ex-del:hover { color: #ff7766; border-color: rgba(255,80,80,0.4); }
			.btn-ex-del[disabled] { opacity: 0.3; cursor: not-allowed; pointer-events: none; }

			.ex-edit-form {
				display: flex; gap: 0.5rem; align-items: end; flex-wrap: wrap; flex: 1;
			}
			.ex-edit-form input, .ex-edit-form select {
				background: rgba(0,255,136,0.04); border: 1px solid var(--border);
				border-radius: 3px; color: var(--green); font-family: inherit;
				font-size: 0.8rem; padding: 0.35rem 0.5rem; outline: none;
			}
		</style>
	}
}

templ exerciseDisplayRow(e db.Exercise, count int) {
	<div class="ex-row">
		<div class="ex-row-left">
			<span class="ex-name">{ e.Name }</span>
			<span class="ex-count">{ fmt.Sprintf("%d sets logged", count) }</span>
		</div>
		<div class="ex-actions">
			<a class="btn-ex-edit" href={ templ.SafeURL(fmt.Sprintf("/exercises?edit=%d", e.ID)) }>edit</a>
			<form method="POST" action="/exercises/delete" style="margin:0"
				onsubmit={ confirmDelete(e.Name, count) }>
				<input type="hidden" name="id" value={ fmt.Sprintf("%d", e.ID) }/>
				<button type="submit" class="btn-ex-del" disabled?={ count > 0 }
					title={ deleteTitle(count) }>delete</button>
			</form>
		</div>
	</div>
}

templ exerciseEditRow(e db.Exercise, bodyParts []string) {
	<div class="ex-row">
		<form method="POST" action="/exercises/update" class="ex-edit-form">
			<input type="hidden" name="id" value={ fmt.Sprintf("%d", e.ID) }/>
			<input type="text" name="name" value={ e.Name } required style="flex:2; min-width:140px;"/>
			<select name="body_part" style="flex:1; min-width:100px;">
				<option value="">— none —</option>
				for _, bp := range bodyParts {
					<option value={ bp } selected?={ e.BodyPart.Valid && e.BodyPart.String == bp }>{ bp }</option>
				}
			</select>
			<button type="submit" class="btn-terminal">save</button>
			<a href="/exercises" class="btn-ex-edit">cancel</a>
		</form>
	</div>
}

func deleteTitle(count int) string {
	if count > 0 {
		return fmt.Sprintf("can't delete — %d sets reference this exercise. Delete those first.", count)
	}
	return "delete exercise"
}

func confirmDelete(name string, count int) templ.ComponentScript {
	if count > 0 {
		return templ.ComponentScript{Call: "return false"}
	}
	return templ.ComponentScript{
		Call: fmt.Sprintf("return confirm('Delete exercise %q?')", name),
	}
}
